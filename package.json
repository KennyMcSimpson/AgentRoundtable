{
  "name": "agent-roundtable",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Governed multi-agent roundtable for the coding agents you already run: deterministic turn moderation, Work/Meet/Summary governance, artifact freeze & recompute, snapshot-isolated disclosure, native-log audit, group-chat & Arena UI, SSE multi-room daemon, zero runtime dependencies.",
  "type": "module",
  "bin": {
    "agent-roundtable": "./room.mjs",
    "room-dev": "./room.mjs"
  },
  "files": [
    "room.mjs",
    "lib/",
    "ui/",
    "skills/",
    "docs/*.md",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KennyMcSimpson/AgentRoundtable.git"
  },
  "homepage": "https://github.com/KennyMcSimpson/AgentRoundtable#readme",
  "bugs": {
    "url": "https://github.com/KennyMcSimpson/AgentRoundtable/issues"
  },
  "keywords": [
    "multi-agent",
    "coding-agents",
    "roundtable",
    "governance",
    "codex",
    "claude-code",
    "antigravity",
    "gemini",
    "local-first",
    "sse",
    "zero-dependencies"
  ],
  "scripts": {
    "demo": "node room.mjs demo",
    "doctor": "node room.mjs doctor",
    "test": "node --test \"test/**/*.test.mjs\"",
    "e2e": "node test/e2e.mjs",
    "daemon": "node room.mjs daemon",
    "evidence": "node evidence/collect.mjs",
    "app": "node dist/build-app.mjs",
    "public-scan": "node dist/public-scan.mjs",
    "export-public": "node dist/export-public.mjs"
  }
}
