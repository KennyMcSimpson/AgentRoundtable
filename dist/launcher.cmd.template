@echo off
setlocal EnableExtensions
chcp 65001 >nul
rem AgentRoundtable {{VERSION}} launcher, rendered by dist/build.mjs on {{BUILD_DATE}} (Node {{NODE_VERSION}}).
rem Usage: launch.cmd [port]
rem   Starts the lobby (room.mjs lobby --open): a loopback page where rooms and seats are created, each
rem   agent gets its one sentence, and a room's UI is opened. The page opens in the default browser.
rem   port    loopback port for the lobby (default: {{DEFAULT_PORT}}; a free port is used when it is busy)
rem Rooms live under %USERPROFILE%\room-dev\rooms, or %ROOM_DEV_HOME%\rooms when ROOM_DEV_HOME is set:
rem the same rule as appRoot() in lib/common.mjs. Never under AppData: an MSIX-packaged parent
rem redirects AppData writes (INTERFACES 1).
rem Closing this window stops the lobby and every room it opened.

set "ROOT=%~dp0"
set "PORT=%~1"
if "%PORT%"=="" set "PORT={{DEFAULT_PORT}}"
rem Rooms root: mirrors defaultRoomsRoot() = (ROOM_DEV_HOME or %USERPROFILE%\room-dev) + \rooms.
set "ROOMS=%USERPROFILE%\room-dev\rooms"
if defined ROOM_DEV_HOME set "ROOMS=%ROOM_DEV_HOME%\rooms"
set "APP=%ROOT%app\room.mjs"
set "NODE_EXE=%ROOT%node\node.exe"
title AgentRoundtable Launcher

echo AgentRoundtable {{VERSION}}
echo.
echo Requirements:
echo   - Your agent must be able to run a local command (it may prompt for permission on first use).
echo   - Codex seats use wake pushes (codex.exe is located via CODEX_CLI_PATH, config.toml, or the install directory).
echo   - Built-in Pi seats install from npm on first use at your choice; exec tier requires Git for Windows or PowerShell tools.
echo.

if not exist "%APP%" (
  echo Could not find %APP%. This archive is incomplete.
  pause
  exit /b 9
)

if not exist "%NODE_EXE%" (
  where node >nul 2>nul
  if errorlevel 1 (
    echo Could not find a Node.js runtime: node\node.exe is missing [{{NODE_NOTE}}] and node is not on PATH.
    echo Install Node ^>= 22 from https://nodejs.org and try again.
    pause
    exit /b 9
  )
  set "NODE_EXE=node"
  echo Using node from PATH [{{NODE_NOTE}}].
)
rem Same version probe as the dev launcher, for the bundled runtime and the PATH fallback alike.
"%NODE_EXE%" -e "process.exit(Number(process.versions.node.split('.')[0]) >= 22 ? 0 : 1)"
if errorlevel 1 (
  echo This node version is too old: %NODE_EXE%. Node.js 22 or newer is required: https://nodejs.org
  pause
  exit /b 9
)

echo Rooms directory: %ROOMS%
echo Starting AgentRoundtable Launcher; your default browser will open automatically.
echo Keep this window open: closing it exits the launcher and stops all rooms opened from it.
echo.

"%NODE_EXE%" "%APP%" lobby --open --port %PORT%
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
  echo Launcher exited with code %RC%.
  pause
)
endlocal & exit /b %RC%
